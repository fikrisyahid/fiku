{
  "name": "fiku-root",
  "version": "0.1.0",
  "private": true,
  "description": "Fiku Finance Platform - Root Task Runner",
  "scripts": {
    "dev": "uv run ops/workflow.py dev",
    "check": "uv run ops/workflow.py check",
    "lint": "uv run ops/workflow.py lint",
    "build": "uv run ops/workflow.py build",
    "start": "uv run ops/workflow.py start",
    "install:main": "uv run ops/workflow.py install",
    "sync:env": "uv run ops/workflow.py sync-env",
    "db:studio": "uv run ops/workflow.py db studio",
    "db:sync": "uv run ops/workflow.py db sync",
    "db:reset": "uv run ops/workflow.py db reset",
    "fiku": "uv run ops/workflow.py"
  },
  "packageManager": "bun@1.4.2"
}
